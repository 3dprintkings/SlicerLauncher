<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SlicerLauncher</AssemblyName>
    <RootNamespace>SlicerLauncher</RootNamespace>
    <ApplicationIcon>Assets\SlicerLauncher.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>Nino King</Authors>
    <Company>3dprintkings</Company>
    <Product>SlicerLauncher</Product>
    <Description>Free and open-source Windows utility for opening STL and 3MF files with the slicer of your choice, including Fusion 360 Print Utility support.</Description>
    <Copyright>Copyright © 2026 Nino King · 3dprintkings</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\SlicerLauncher-logo.png" />
    <EmbeddedResource Include="Assets\circle_icon.png" />
  </ItemGroup>
</Project>
